# متغيرات لوحة التحكم — أسماء بس، من غير أي قيمة.
# انسخ الملف ده لـ .env.local محليًا. .env.local متجاهَل في git.
#
# 🔒 ممنوع تمامًا أي متغير هنا يبقى NEXT_PUBLIC_.
# مفيش عميل Supabase في المتصفح، فمفيش داعي لأي مفتاح هناك.

# مشروع Supabase
SUPABASE_URL=

# المفتاح المجهول — للمصادقة بس (تسجيل الدخول وتجديد الجلسة).
# مش سر بمعنى الكلمة، لكنه سيرفر-سايد هنا ومالوش لزمة في المتصفح.
SUPABASE_ANON_KEY=

# 🔒 سر. بيتخطى RLS بالكامل.
# استخدامه: قراءات المرحلة ب + قراءة الدور من admin_users.
# ⚠️ حل انتقالي — لازم يتبدل بدور قراءة محدود قبل نشر اللوحة.
SUPABASE_SERVICE_ROLE_KEY=

# علم الجاهزية. بيفضل false في المرحلة ج.
ADMIN_MUTATIONS_ENABLED=false

# رابط المتجر المنشور، لتحديث البيانات المعروضة فورًا بعد الحفظ.
STOREFRONT_URL=
# 🔒 سر مشترك مع مشروع المتجر. لا يبدأ بـ NEXT_PUBLIC_.
REVALIDATE_SECRET=
