# ================================================================
# متغيرات بيئة المتجر — أسماء وقيم وهمية فقط
#
# 🔒 ممنوع أي سر حقيقي في الملف ده ولا في أي ملف في الريبو.
#    القيم الحقيقية بتتظبط في Vercel Project Settings بس.
# 🔒 ممنوع أي متغير هنا يبقى NEXT_PUBLIC_ — مفيش عميل Supabase في المتصفح.
# ================================================================

# مصدر بيانات المتجر — مفيش قيمة افتراضية عن قصد.
# fallback = الكتالوج المؤقت (CI والتطوير المحلي) · supabase = البيانات الحقيقية
STOREFRONT_DATA_SOURCE=fallback

# رابط مشروع Supabase
SUPABASE_URL=https://example-project.supabase.co

# دور قراءة محدود الصلاحية — المستهدف. سيبه فاضي لو لسه مش متعمل.
SUPABASE_READ_KEY=

# ⚠️ مؤقت وبيتخطى RLS بالكامل. **سيرفر فقط.**
# مطلوب لاستدعاء zell_create_order و zell_get_order_receipt، لأن
# zell_order_writer معمول nologin ومفيش حد بيتصل بيه.
SUPABASE_SERVICE_ROLE_KEY=server-only-placeholder-not-a-real-key

# بوّابة استقبال الطلبات — **مقفولة افتراضياً**.
# الدمج والنشر ما بيفتحوش استقبال الطلبات تلقائياً: لازم تتظبط 'true'
# صراحة + إعادة نشر. وما تتفتحش قبل تنفيذ الإشعار (§7) واختباره، إلا
# بقرار تشغيلي صريح ومنفصل.
ORDERS_ENABLED=false

# إشعار الأدمن على تليجرام — **سيرفر فقط** (§7.3).
# 🔒 القيم الحقيقية في Vercel بس. ممنوع تتكتب هنا ولا في أي ملف ولا في شات.
# 🔒 ممنوع تتقرا من جدول settings — الصفّين اللي هناك هيتحذفوا في 0007.
# المتغير الناقص **مش خطأ**: الطلب بيتسجّل عادي و notify_error بيبقى
# TELEGRAM_NOT_CONFIGURED.
TELEGRAM_BOT_TOKEN=000000000:replace-me-in-vercel-only
TELEGRAM_CHAT_ID=-1000000000000

# 🔒 سر endpoint تحديث كاش المتجر. نفس القيمة في مشروع لوحة التحكم.
REVALIDATE_SECRET=
